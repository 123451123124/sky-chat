# PostgreSQL / Supabase connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Alibaba Cloud Model Studio (Beijing, OpenAI-compatible chat)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Set a random secret before running production (required)
JWT_SECRET=""

# RAG: defaults to the chat provider/key; ES uses 2048 dimensions, legacy pgvector 1024.
# If changing the embedding profile, re-upload/re-index existing documents.
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-v4"
# Per process, including all concurrent file jobs. Batch size is capped at 10.
EMBEDDING_CONCURRENCY="3"
EMBEDDING_BATCH_SIZE="10"
EMBEDDING_RPM="120"
RAG_WORKER_CONCURRENCY="2"
# Rerank defaults to the current Alibaba key and its origin's native API.
RERANK_ENABLED="true"
RERANK_MODEL="qwen3-rerank"
RERANK_API_KEY=""
RERANK_URL=""
RAG_CANDIDATES="24"
RAG_TOP_K="6"

# RAG backends: opt in after ES/IK, Kafka and the incremental migration are ready.
RAG_SEARCH_BACKEND="elasticsearch"
RAG_INGESTION_BACKEND="kafka"
ELASTICSEARCH_URL="http://127.0.0.1:19200"
ELASTICSEARCH_INDEX="sky-chat-chunks-v1"
ELASTICSEARCH_API_KEY=""
ES_CANDIDATES="50"
ES_NUM_CANDIDATES="200"
ES_RESCORE_WINDOW="100"
KAFKA_BROKERS="127.0.0.1:19092"
KAFKA_TOPIC_PREFIX="sky-chat-rag-v1"
KAFKA_REPLICATION_FACTOR="1"
# Shared persistent directory for the web process and the RAG worker.
RAG_STORAGE_DIR=".data/rag"

# Optional: web search and administrator seed configuration
SEARCH_API_KEY=""
SEARCH_API_URL="https://api.tavily.com/search"
ADMIN_EMAIL="admin@skychat.com"
ADMIN_PASSWORD=""

# Optional: separate OpenAI-compatible image-generation provider
IMAGE_API_KEY=""
IMAGE_BASE_URL=""
IMAGE_MODEL=""
